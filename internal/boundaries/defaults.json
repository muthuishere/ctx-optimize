      "tier": "INFERRED",
      "verified": {
        "at": "2026-08-14",
        "ground_truth": {
          "tool": "ctx-optimize search",
          "cmd": "search '(localStorage|sessionStorage)\\.(getItem|setItem|removeItem)\\(' --ext .ts,.tsx,.js --count  # corpora: ts-typescript, ts-hono — ZERO sites"
        },
        "expected": 0,
        "matched": 0,
        "sampled": 0,
        "confirmed": 0,
        "known_misses": [
          "no corpus sites available — fixture-verified only; unmeasured never claims EXTRACTED, tier capped at INFERRED"
        ]
      }
    },
    {
      "id": "websocket-js",
      "transport": "network.ws",
      "direction": "consumes",
      "when": {
        "ext": [
          ".ts",
          ".tsx",
          ".js",
          ".jsx"
        ]
      },
      "exclude": {
        "path": [
          "testdata/",
          "benchmarks/"
        ]
      },
      "match": [
        {
          "re": "new\\s+(?:WebSocket|EventSource)\\(\\s*[`'\"]([^`'\"]{1,120})",
          "identifier": 1
        }
      ],
      "tier": "INFERRED",
      "verified": {
        "at": "2026-08-14",
        "ground_truth": {
          "tool": "ctx-optimize search",
          "cmd": "search 'new\\s+(WebSocket|EventSource)\\(' --ext .ts,.tsx,.js --count  # corpora: ts-typescript, ts-hono"
        },
        "expected": 2,
        "matched": 1,
        "recall": 0.5,
        "sampled": 1,
        "confirmed": 1,
        "precision": 1.0,
        "known_misses": [
          "new WebSocket(urlVar) — url is a variable",
