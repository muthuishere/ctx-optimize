          "identifier": 1
        }
      ],
      "metadata": {
        "otel.http.route": "$identifier"
      },
      "tier": "INFERRED",
      "verified": {
        "at": "2026-08-14",
        "ground_truth": {
          "tool": "ctx-optimize search",
          "cmd": "search '@\\w[\\w.]*\\.(get|post|put|delete|patch|route)\\(' --ext .py --count  # corpus: py-flask"
        },
        "expected": 306,
        "matched": 303,
        "recall": 0.99,
        "sampled": 3,
        "confirmed": 3,
        "precision": 1.0,
        "known_misses": [
          "app.add_url_rule(...) programmatic registration",
          "multi-line decorators; tier capped at INFERRED per D3 (regex, not AST)"
        ]
      }
    },
    {
      "id": "webstorage",
