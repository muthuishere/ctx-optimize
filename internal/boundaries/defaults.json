      "id": "http-url-literal",
      "transport": "network.http",
      "direction": "consumes",
      "when": {
        "ext": [
          ".go",
          ".ts",
          ".tsx",
          ".js",
          ".jsx",
          ".py",
          ".java",
          ".cs"
        ]
      },
