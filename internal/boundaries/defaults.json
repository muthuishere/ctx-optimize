        "path": [
          "testdata/",
          "benchmarks/",
          "docs/",
          "site/"
        ]
      },
      "metadata": {
        "otel.server.address": "$identifier"
      },
      "tier": "INFERRED",
      "verified": {
        "at": "2026-08-14",
        "ground_truth": {
          "tool": "ctx-optimize search",
          "cmd": "search '[\"'`]https?://' --ext .go,.ts,.tsx,.js,.py --count  # corpora: ts-typescript, py-django, go-kubernetes, ctx-optimize",
          "re": "[\"'`]https?://",
          "ext": [
            ".go",
            ".ts",
            ".tsx",
            ".js",
            ".py"
          ],
          "corpora": [
            "ts-typescript",
            "py-django",
            "go-kubernetes",
            "ctx-optimize"
          ]
        },
        "expected": 2776,
        "matched": 2432,
        "recall": 0.88,
        "sampled": 10,
        "confirmed": 10,
        "precision": 1.0,
        "known_misses": [
          "template hosts \u2014 f\"https://{host}\", %s, ${} (the AMBIGUOUS lane needs the literal to match first)",
          "URLs assembled by concatenation",
          "bare scheme strings (\"https://\")"
        ]
      },
      "ast": [
        {
          "shape": "literal",
          "url_scheme": [
            "http",
            "https"
          ],
          "take": "host"
        }
      ]
    },
    {
      "id": "http-url-literal-unparsed",
      "transport": "network.http",
      "direction": "consumes",
      "when": {
        "ext": [
          ".kt",
          ".swift",
          ".rb"
        ]
      },
      "exclude": {
        "path": [
          "testdata/",
          "benchmarks/"
        ]
      },
      "scan": "raw",
      "match": [
        {
          "re": "[\"'`]https?://([a-zA-Z0-9][a-zA-Z0-9.-]*)(?::\\d+)?[\"'`/:?]",
          "identifier": 1
        }
      ],
      "metadata": {
        "otel.server.address": "$identifier"
      },
      "tier": "INFERRED",
      "verified": {
        "at": "2026-08-14",
        "ground_truth": {
          "tool": "ctx-optimize search",
          "cmd": "search '[\\x22\\x27\\x60]https?://' --ext .kt --ext .swift --ext .rb --count  # corpus: java-spring",
          "re": "[\\x22\\x27\\x60]https?://",
          "ext": [
            ".kt",
            ".swift",
            ".rb"
          ],
          "corpora": [
            "java-spring"
          ]
        },
        "_note": "DECLARED raw-byte escape hatch (ADR 2026-08-14 D3): these languages have no embedded tree-sitter grammar, so the AST lane cannot see them at all. If a grammar pack for one lands, move its extension to http-url-literal.",
        "expected": 65,
        "matched": 65,
        "recall": 1.0,
        "sampled": 0,
        "confirmed": 0,
        "precision": null,
        "known_misses": [
          "URLs inside a LARGER literal (HTML/template fixtures) \u2014 the pattern scans raw bytes so it finds them; the AST lane deliberately does not",
          "template hosts, concatenation \u2014 same as http-url-literal",
          "precision NOT independently sampled here \u2014 pattern is http-url-literal's verbatim (sampled 10/10 there)"
        ]
      }
    },
