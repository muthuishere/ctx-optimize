{
  "repo": "https://github.com/gorilla/mux",
  "name": "gorilla-mux-graded",
  "comment": "ANSWER-QUALITY question set. Every question carries a `grade` block whose facts were verified by hand against the checked-out source with ripgrep (see `truth` on each fact for the exact file:line). The grader scores the AGENT'S FINAL ANSWER, deterministically, with no model in the loop and no knowledge of which arm produced it — so arm a (shell), arm b (ctx-optimize) and arm c (graphify) are judged by the identical rule. `impact` questions are the load-bearing class: they are the 'who calls this function' claim.",
  "questions": [
    {
      "id": "i1",
      "class": "impact",
      "prompt": "Which functions or methods call Route.addRegexpMatcher? List every caller.",
      "grade": {
        "facts": [
          { "name": "Route.Host", "truth": "route.go:367", "any_of": ["route.host", ") host(", "func (r *route) host"] },
          { "name": "Route.Path", "truth": "route.go:427", "any_of": [") path(", "route.path(", "`path`", "path method"] },
          { "name": "Route.PathPrefix", "truth": "route.go:443", "any_of": ["pathprefix"] },
          { "name": "Route.Queries", "truth": "route.go:474", "any_of": ["queries"] }
        ],
        "forbid": [
          { "name": "claims no callers", "any_of": ["no callers", "nothing calls", "is not called", "no other code calls"] }
        ]
      }
    },
    {
      "id": "i2",
      "class": "impact",
      "prompt": "Which function calls uniqueVars, and where?",
      "grade": {
        "facts": [
          { "name": "addRegexpMatcher is the sole caller", "truth": "route.go:267,273,280", "any_of": ["addregexpmatcher"] },
          { "name": "cites route.go", "truth": "route.go", "any_of": ["route.go"] }
        ],
        "forbid": [
          { "name": "claims no callers", "any_of": ["no callers", "nothing calls", "is not called"] }
        ]
      }
    },
    {
      "id": "i3",
      "class": "impact",
