---
// Overrides Starlight's Header to put the top-level nav at the RIGHT end,
// beside the GitHub icon and the theme select — not trailing the wordmark.
//
// It has to exist somewhere: the homepage uses `template: splash`, which
// renders no sidebar, so without these links the only route into the docs is
// the hero button. Otherwise identical to
// @astrojs/starlight/components/Header.astro.
import config from 'virtual:starlight/user-config';

import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
	{ label: 'Docs', href: `${base}/guide/` },
	{ label: 'Boundaries', href: `${base}/boundaries/` },
	{ label: 'Benchmarks', href: `${base}/benchmarks/` },
];
const here = Astro.url.pathname;

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header sl-flex">
	<div class="title-wrapper">
		<SiteTitle {...Astro.props} />
	</div>
	<div class="search-slot sl-flex print:hidden">
		{shouldRenderSearch && <Search {...Astro.props} />}
	</div>
	<div class="sl-hidden md:sl-flex right-group">
		<nav class="ctx-nav" aria-label="Main">
			{
				links.map((l) => (
					<a href={l.href} aria-current={here.startsWith(l.href) ? 'page' : undefined}>
						{l.label}
					</a>
				))
			}
		</nav>
		<div class="sl-flex social-icons">
			<SocialIcons {...Astro.props} />
		</div>
		<ThemeSelect {...Astro.props} />
	</div>
</div>

<style>
	.header {
		gap: 1rem 1.25rem;
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}
	.title-wrapper {
		display: flex;
		align-items: center;
		min-width: 0;
		flex: 0 1 auto;
	}
	.search-slot {
		flex: 1 1 12rem;
		min-width: 0;
		justify-content: flex-end;
		align-items: center;
	}
	.right-group {
		gap: 1rem;
		align-items: center;
		flex-shrink: 0;
	}
	.social-icons {
		align-items: center;
		gap: 0.65rem;
	}
	.social-icons :global(a) {
		color: var(--sl-color-gray-2);
		display: inline-flex;
		align-items: center;
		line-height: 0;
	}
	.social-icons :global(a:hover) {
		color: var(--sl-color-white);
	}
	.social-icons :global(svg) {
		width: 1.05rem;
		height: 1.05rem;
	}
	.social-icons::after {
		content: '';
		height: 1.15rem;
		border-inline-end: 1px solid var(--sl-color-gray-5);
		align-self: center;
	}
	.ctx-nav {
		display: none;
		gap: 1.25rem;
		align-items: center;
		white-space: nowrap;
	}
	/* Only once the header has room for them; below this Starlight moves
	   navigation into the sidebar drawer anyway. */
	@media (min-width: 60rem) {
		.ctx-nav {
			display: flex;
		}
	}
	.ctx-nav a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
		font-size: var(--sl-text-sm);
		font-weight: 500;
	}
	.ctx-nav a:hover {
		color: var(--sl-color-white);
	}
	.ctx-nav a[aria-current='page'] {
		color: var(--sl-color-text-accent);
	}
	@media (min-width: 50rem) {
		.header {
			display: flex;
			align-items: center;
		}
	}
</style>
