---
// Dashboard wordmark: ctx-<em>optimize</em> + "gather once · answer from the store"
//
// The version comes from CHANGELOG.md at BUILD time — the release record in
// this repo, not a hand-typed string and not a network call. A site that does
// not say which version it documents sends a reader to try a verb that may not
// exist yet, and the answer to "is this current?" was unavailable on both the
// dashboard and here until each was told to say so.
//
// If the changelog cannot be read the badge simply does not render: a wrong
// version is worse than no version.
import fs from "node:fs";
import path from "node:path";

const href = import.meta.env.BASE_URL;

let version = "";
try {
	const md = fs.readFileSync(path.resolve("../CHANGELOG.md"), "utf8");
	// the first released heading, skipping [Unreleased]
	const m = md.match(/^## \[(\d+\.\d+\.\d+)\]/m);
	if (m) version = "v" + m[1];
} catch {
	version = "";
}
---

<a href={href} class="ctx-logo">
	<span class="mark">ctx-<em>optimize</em></span>
	<span class="tag">gather once · answer from the store</span>
	{version && <span class="ver">{version}</span>}
</a>

<style>
	.ctx-logo {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		min-width: 0;
		text-decoration: none;
		color: inherit;
	}
	.ctx-logo:hover .mark {
		opacity: 0.82;
	}
	.mark {
		font-weight: 700;
		font-size: 1.15rem;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
		white-space: nowrap;
		line-height: 1;
	}
	.mark em {
		color: var(--sl-color-accent);
		font-style: normal;
	}
	.tag {
		color: var(--sl-color-gray-4);
		font-size: 0.78rem;
		font-family: var(--sl-font-mono);
		letter-spacing: 0.04em;
		white-space: nowrap;
		line-height: 1.2;
		padding-top: 0.12em;
	}
	.ver {
		font-family: var(--sl-font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--sl-color-gray-3);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		padding: 0.18em 0.5em;
		line-height: 1;
		white-space: nowrap;
	}
	.ctx-logo:hover .ver {
		color: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
	}
	@media (max-width: 48rem) {
		.tag {
			display: none;
		}
	}
</style>
